# Default-deny: ignore everything, then explicitly re-include only what the
# Docker build (yarn install / packages-build / yarn run build) and
# runtime (yarn run start) actually need.
*

# Package manager / workspace manifests required for `yarn install`.
!package.json
!yarn.lock
!.yarnrc.yml
!lerna.json
!nx.json

# Yarn Berry toolchain: only the parts required to run the pinned `yarnPath`
# binary and (optionally) plugins/patches/sdks.
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
!.yarn/patches

# Source only for packages.
# Their lib/ build output and Relay __generated__ artifacts are rebuilt by `yarn run packages-build`.
!packages
packages/*/*/lib
packages/*/*/**/__generated__

# App, server, shared and style sources.
!src
src/app/**/__generated__

# Static assets copied into _static/.
!static

# Only scripts/build/ is used by `yarn run build`; the rest of scripts/ is dev tooling.
!scripts/build

# Root-level build config.
!webpack.config.js

# Kept for compliance/legal visibility even though not functionally required:
# digitransit-ui is dual AGPL-3.0/EUPL-1.2 licensed.
!COPYING
!LICENSE-AGPL.txt
!LICENSE-EUPL.txt
