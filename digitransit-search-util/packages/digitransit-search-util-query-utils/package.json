{
  "name": "@digitransit-search-util/digitransit-search-util-query-utils",
  "version": "4.5.15",
  "description": "digitransit-search-util query-utils module",
  "main": "lib/index.cjs",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf lib ./node_modules",
    "pretest": "yarn build",
    "test": "vitest run --config ../../../config/vitest.config.js \"$PWD/test.js\"",
    "docs": "node ../../../scripts/workspace-packages/generate-readmes.mjs",
    "relay": "mkdir -p lib/__generated__ && relay-compiler && echo '{\"type\":\"commonjs\"}' > lib/package.json",
    "relay-watch": "mkdir -p lib/__generated__ && echo '{\"type\":\"commonjs\"}' > lib/package.json && relay-compiler --watch",
    "watch": "yarn relay && NODE_ENV=development rollup -w -c ../../../config/rollup.config.js",
    "build": "yarn relay && NODE_ENV=production rollup -c ../../../config/rollup.config.js"
  },
  "relay": {
    "src": "./src",
    "schema": "./schema/schema.graphql",
    "language": "javascript",
    "artifactDirectory": "./lib/__generated__"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/HSLdevcom/digitransit-ui.git"
  },
  "keywords": [
    "digitransit-search-util",
    "QueryUtils"
  ],
  "author": "Digitransit Authors",
  "license": "(AGPL-3.0 OR EUPL-1.2)",
  "peerDependencies": {
    "graphql": "16.8.1",
    "lodash": "4.18.1",
    "react-relay": "16.2.0"
  },
  "devDependencies": {
    "babel-plugin-relay": "16.2.0",
    "relay-compiler": "16.2.0"
  },
  "dependencies": {
    "@digitransit-search-util/digitransit-search-util-filter-matching-to-input": "workspace:^",
    "@digitransit-search-util/digitransit-search-util-helpers": "workspace:^",
    "@digitransit-search-util/digitransit-search-util-route-name-compare": "workspace:^"
  }
}
