{
  "name": "@digitransit-search-util/digitransit-search-util-query-utils",
  "version": "4.5.21",
  "description": "digitransit-search-util query-utils module",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "digitransit-source": "./src/index.js",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf lib ./node_modules",
    "test": "vitest run --config ../../../vitest.config.js \"$PWD/test.js\"",
    "docs": "node ../../../scripts/workspace-packages/generate-readmes.js",
    "relay": "relay-compiler",
    "relay-watch": "relay-compiler --watch",
    "watch": "yarn relay && NODE_ENV=development rollup -w -c ../../../config/rollup.config.js",
    "copy-schema": "mkdir -p lib/schema && cp ../../../schema/schema.graphql lib/schema/schema.graphql",
    "build": "yarn relay && yarn copy-schema && NODE_ENV=production rollup -c ../../../config/rollup.config.js"
  },
  "relay": {
    "src": "./src",
    "schema": "../../../schema/schema.graphql",
    "language": "javascript",
    "eagerEsModules": true
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/HSLdevcom/digitransit-ui.git"
  },
  "keywords": [
    "digitransit-search-util",
    "QueryUtils"
  ],
  "author": "Digitransit Authors",
  "license": "(AGPL-3.0 OR EUPL-1.2)",
  "peerDependencies": {
    "graphql": "16.8.1",
    "lodash": "4.18.1",
    "react-relay": "16.2.0"
  },
  "devDependencies": {
    "babel-plugin-relay": "16.2.0",
    "relay-compiler": "16.2.0"
  },
  "dependencies": {
    "@digitransit-util/digitransit-util": "workspace:^"
  }
}
