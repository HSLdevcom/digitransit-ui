# macOS Finder metadata
.DS_Store

# Main app webpack build output (see webpack.config.js)
_static
manifest.json

# Installed dependencies (yarn/npm)
node_modules

# Relay-compiler generated GraphQL artifacts (main app and query-utils)
app/**/__generated__
utils/**/__generated__
packages/*/*/**/__generated__

# Rollup build output (see packages/private/rollup-config).
packages/*/*/lib

# Nx's local task-graph/build cache (used by `lerna run build`/`watch` via
# nx.json's task pipeline) - always safe to delete, regenerated on demand.
.nx

# Tool debug logs (lerna, yarn, etc.)
*.log

# JSON summary written by `lerna publish --summary-file` (used by the
# publish-npm CI job); only produced when actually publishing.
lerna-publish-summary.json

# Yarn Berry (zero-installs) cache - only keep the config/tooling subdirs, not the
# downloaded package cache itself
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
.npmrc

# IntelliJ
.idea
*.iml

# VS Code - only keep the shared configs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Copilot - only keep the shared settings
.github/copilot/*
!.github/copilot/settings.json

# Claude - only keep the shared settings
.claude/*
!.claude/settings.json

# various files
test/credentials.json
*.swp
*~
tags
run*.sh
dump.rdb

# Playwright MCP output
.playwright-mcp/
