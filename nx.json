{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/config/rollup.config.js",
        "{workspaceRoot}/config/rollup-plugin-scss-modules.js",
        "{workspaceRoot}/config/babel.config.cjs"
      ],
      "outputs": ["{projectRoot}/lib"],
      "cache": true
    }
  }
}
