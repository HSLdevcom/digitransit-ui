{
  "name": "@digitransit-store/digitransit-store-common-functions",
  "version": "1.0.2",
  "description": "digitransit-store common-functions module",
  "type": "module",
  "main": "lib/index.cjs",
  "deprecated": "This package has no real consumers. It will be removed in a future release.",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.cjs"
    },
    "./src/index.js": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "/lib",
    "LICENSE-AGPL.txt",
    "LICENSE-EUPL.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "NODE_ENV=development rollup -w -c ../../../config/rollup.config.js",
    "clean": "rm -rf ./lib ./node_modules",
    "test": "vitest run --config ../../../vitest.config.js \"$PWD/test.js\"",
    "docs": "node ../../../scripts/workspace-packages/generate-readmes.js",
    "build": "NODE_ENV=production rollup -c ../../../config/rollup.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/HSLdevcom/digitransit-ui.git"
  },
  "keywords": [
    "digitransit-store",
    "CommonFunctions"
  ],
  "author": "Digitransit Authors",
  "license": "(AGPL-3.0 OR EUPL-1.2)"
}
