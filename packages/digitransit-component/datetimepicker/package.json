{
  "name": "@digitransit-component/digitransit-component-datetimepicker",
  "version": "9.1.8",
  "description": "digitransit-component datetimepicker module",
  "type": "module",
  "main": "index.cjs",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/lib",
    "index.cjs",
    "LICENSE-AGPL.txt",
    "LICENSE-EUPL.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "NODE_ENV=development node $PROJECT_CWD/node_modules/rollup/dist/bin/rollup -w -c",
    "clean": "rm -rf ./lib ./node_modules",
    "test": "yarn run -T vitest run --config ../../../vitest.config.js \"$(pwd)/test.jsx\"",
    "docs": "node ../../../scripts/packages/generate-readmes.js",
    "build": "NODE_ENV=production node $PROJECT_CWD/node_modules/rollup/dist/bin/rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/HSLdevcom/digitransit-ui.git"
  },
  "keywords": [
    "digitransit-component",
    "Datetimepicker"
  ],
  "author": "Digitransit Authors",
  "license": "(AGPL-3.0 OR EUPL-1.2)",
  "devDependencies": {
    "@digitransit-ui/rollup-config": "workspace:^"
  },
  "peerDependencies": {
    "@digitransit-component/digitransit-component-icon": "workspace:^",
    "@hsl-fi/sass": "^1.0.0",
    "classnames": "^2.5.1",
    "downshift": "^9.4.0",
    "i18next": "^22.5.1",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-i18next": "^12.3.1",
    "react-modal": "^3.16.3",
    "react-select": "^5.10.2"
  }
}
