{
  "name": "@digitransit-component/digitransit-component-icon",
  "version": "5.0.4",
  "description": "digitransit-component icon module",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "/lib",
    "LICENSE-AGPL.txt",
    "LICENSE-EUPL.txt"
  ],
  "publishConfig": {
