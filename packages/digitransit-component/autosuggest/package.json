{
  "name": "@digitransit-component/digitransit-component-autosuggest",
  "version": "11.0.6",
  "description": "digitransit-component autosuggest module",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./index.css": "./lib/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "/lib",
    "LICENSE-AGPL.txt",
    "LICENSE-EUPL.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "node $PROJECT_CWD/node_modules/vite/bin/vite.js build --watch",
    "clean": "rm -rf ./lib ./node_modules",
    "test": "yarn run -T vitest run --config ../../../vitest.config.js \"$(pwd)/test.jsx\"",
    "docs": "node ../../../scripts/packages/generate-readmes.js",
    "build": "node $PROJECT_CWD/node_modules/vite/bin/vite.js build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/HSLdevcom/digitransit-ui.git"
  },
  "keywords": [
    "digitransit-component",
    "Autosuggest"
  ],
  "author": "Digitransit Authors",
  "license": "(AGPL-3.0 OR EUPL-1.2)",
  "dependencies": {
    "@digitransit-search-util/digitransit-search-util-execute-search-immediate": "workspace:^",
    "@digitransit-search-util/digitransit-search-util-get-label": "workspace:^",
    "@digitransit-search-util/digitransit-search-util-helpers": "workspace:^",
    "@digitransit-search-util/digitransit-search-util-uniq-by-label": "workspace:^",
    "@hsl-fi/hooks": "^1.2.4"
  },
  "devDependencies": {
    "@digitransit-ui/vite-config": "workspace:^"
  },
  "peerDependencies": {
    "@digitransit-component/digitransit-component-dialog-modal": "workspace:^",
    "@digitransit-component/digitransit-component-icon": "workspace:^",
    "@digitransit-component/digitransit-component-suggestion-item": "workspace:^",
    "@hsl-fi/sass": "^1.0.0",
    "classnames": "^2.5.1",
    "downshift": "^9.4.0",
    "i18next": "^22.5.1",
    "luxon": "^3.7.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-i18next": "^12.3.1",
    "react-modal": "^3.16.3"
  }
}
