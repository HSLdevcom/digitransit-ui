  "peerDependencies": {
    "@digitransit-component/digitransit-component-autosuggest": "workspace:^",
    "@digitransit-component/digitransit-component-icon": "workspace:^",
    "@dnd-kit/react": "^0.5.1",
    "@hsl-fi/sass": "^1.0.0",
    "classnames": "^2.5.1",
    "downshift": "^9.4.0",
