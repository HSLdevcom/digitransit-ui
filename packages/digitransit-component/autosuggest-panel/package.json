  "description": "digitransit-component autosuggest-panel module",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./index.css": "./lib/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "/lib",
    "LICENSE-AGPL.txt",
    "LICENSE-EUPL.txt"
  ],
