{
  "name": "@digitransit-store/digitransit-store-future-route",
  "version": "2.0.6",
  "description": "digitransit-store future-route module",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "/lib",
    "LICENSE-AGPL.txt",
    "LICENSE-EUPL.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "node $PROJECT_CWD/node_modules/vite/bin/vite.js build --watch",
    "clean": "rm -rf ./lib ./node_modules",
    "test": "yarn run -T vitest run --config ../../../vitest.config.js \"$(pwd)/test.js\"",
    "docs": "node ../../../scripts/packages/generate-readmes.js",
    "build": "node $PROJECT_CWD/node_modules/vite/bin/vite.js build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/HSLdevcom/digitransit-ui.git"
  },
  "keywords": [
    "digitransit-store",
    "FutureRoute"
  ],
  "devDependencies": {
    "@digitransit-ui/vite-config": "workspace:^"
  },
  "peerDependencies": {
    "lodash": "^4.18.1"
  },
  "author": "Digitransit Authors",
  "license": "(AGPL-3.0 OR EUPL-1.2)"
