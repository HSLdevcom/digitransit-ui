{
  "name": "digitransit-ui",
  "version": "0.0.1",
  "description": "Digitransit UI - open nationwide journey planning platform",
  "author": "digitransit@hsl.fi",
  "license": "(AGPL-3.0 OR EUPL-1.2)",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*/*"
  ],
  "scripts": {
    "setup": "yarn install && yarn packages-build",
    "static": "node scripts/build/copyStatic.js",
    "sprites": "node scripts/build/buildSprites.js",
    "relay": "relay-compiler",
    "relay-watch": "relay-compiler --watch",
    "prebuild": "yarn run static && yarn run sprites && yarn run relay",
    "build": "NODE_ENV=production sh -c 'yarn prebuild && node --max_old_space_size=4096 node_modules/.bin/webpack --progress --color'",
    "start": "NODE_ENV=production node $NODE_OPTS server/server.js",
    "dev": "bash scripts/dev.sh",
    "dev-nowatch": "RUN_ENV=development NODE_ENV=development sh -c 'node server/server.js & webpack-dev-server'",
    "test-accessibility": "./test/accessibility.sh",
    "test-unit": "yarn relay && yarn packages-build && vitest run",
    "test-unit:app": "yarn relay && yarn packages-build && vitest run --project app",
    "test-unit:server": "vitest run --project server",
    "test:e2e": "jest --runInBand --detectOpenHandles --config=./test/e2e/jest.config.cjs",
    "test:update-snapshots": "UPDATE_E2E=true jest --runInBand --detectOpenHandles --updateSnapshot --config=./test/e2e/jest.config.cjs",
    "test:update-all-desktop-snapshots": "CONFIG=hsl yarn test:update-snapshots && CONFIG=tampere yarn test:update-snapshots && CONFIG=matka yarn test:update-snapshots",
    "test:update-all-mobile-snapshots": "MOBILE=true CONFIG=hsl yarn test:update-snapshots && MOBILE=true CONFIG=tampere yarn test:update-snapshots && MOBILE=true CONFIG=matka yarn test:update-snapshots",
    "test:update-all-snapshots": "yarn test:update-all-desktop-snapshots && yarn test:update-all-mobile-snapshots",
    "lint": "yarn run eslint && yarn run prettier-styles && yarn run prettier-icons && yarn run stylelint && yarn run packages-translations-check && yarn run packages-dependencies-check",
    "format": "yarn run sort-translations && yarn run packages-translations-fix && yarn run eslint-fix && yarn run prettier-styles-fix && yarn run prettier-icons-fix && yarn run stylelint-fix",
    "sort-translations": "node scripts/sort-translations.js",
    "eslint": "eslint . --ext .js,.jsx,.cjs",
    "eslint-fix": "eslint . --ext .js,.jsx,.cjs --fix",
    "prettier-styles": "prettier sass/**/*.scss app/**/*.scss packages/digitransit-component/**/*.scss --check",
    "prettier-styles-fix": "prettier sass/**/*.scss app/**/*.scss packages/digitransit-component/**/*.scss --write",
    "prettier-icons": "prettier 'app/assets/icons/**/*.svg' --check",
    "prettier-icons-fix": "prettier 'app/assets/icons/**/*.svg' --write",
    "stylelint": "stylelint sass/**/*.scss app/**/*.scss packages/digitransit-component/**/*.scss",
    "stylelint-fix": "stylelint sass/**/*.scss app/**/*.scss packages/digitransit-component/**/*.scss --fix",
    "add-theme": "node scripts/theme/add-theme.js",
    "packages-publish": "lerna publish from-package --no-git-tag-version --no-push --summary-file",
    "packages-publish-ci": "lerna publish from-package --no-git-tag-version --no-push --summary-file -y",
    "packages-docs": "node scripts/packages/generate-readmes.js",
    "packages-watch": "lerna run watch --parallel --stream",
    "packages-build": "lerna run build",
    "packages-test": "yarn packages-build && vitest run --project=!app --project=!server",
    "packages-clean": "lerna run clean && rm -rf node_modules/.cache .nx",
    "packages-version-bump": "echo \"THIS SCRIPT WILL PUSH TO THE REMOTE AT THE END!\" && git fetch --tags && lerna version --include-merged-tags",
    "packages-version-check": "node scripts/packages/check-versions.js",
    "packages-translations-check": "node scripts/packages/sort-translations.js",
    "packages-dependencies-check": "node scripts/packages/check-dependencies.js",
    "packages-translations-fix": "node scripts/packages/sort-translations.js --fix"
  },
  "main": "server.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HSLdevcom/digitransit-ui"
  },
  "bugs": {
    "url": "https://github.com/HSLdevcom/digitransit-ui/issues"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24.14.1"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "> 0.2% in FI and fully supports es6-module"
  ],
  "prettier": {
    "arrowParens": "avoid",
    "endOfLine": "auto",
    "singleQuote": true,
    "trailingComma": "all",
    "plugins": [
      "@prettier/plugin-xml"
    ],
    "overrides": [
      {
        "files": "*.svg",
        "options": {
          "parser": "xml",
          "printWidth": 100000,
          "xmlSelfClosingSpace": false,
          "xmlWhitespaceSensitivity": "preserve"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{js,jsx,cjs}": [
      "eslint"
    ],
    "*.scss": [
      "prettier --check",
      "stylelint"
    ],
    "app/assets/icons/**/*.svg": [
      "prettier --check"
    ]
  },
  "git-precommit-checks": {
    "rules": [
      {
        "message": "You have unresolved conflict markers",
        "regex": "/^[<>|=]{4,}/m"
      },
      {
        "filter": "\\.js$",
        "nonBlocking": "true",
        "message": "You are using `console.log` in your JavaScripts",
        "regex": "console\\.log"
      }
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && git-precommit-checks",
      "pre-push": "yarn run test-unit"
    }
  },
  "relay": {
    "src": "./app",
    "schema": "./packages/private/schema/schema.graphql",
    "language": "javascript",
    "eagerEsModules": true
  },
