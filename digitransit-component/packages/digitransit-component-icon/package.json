{
  "name": "@digitransit-component/digitransit-component-icon",
  "version": "3.0.1",
  "description": "digitransit-component icon module",
  "type": "module",
  "main": "index.cjs",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/lib",
    "index.cjs",
    "LICENSE-AGPL.txt",
    "LICENSE-EUPL.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "NODE_ENV=development rollup -w -c ../../../config/rollup.config.js",
    "clean": "rm -rf ./lib ./node_modules",
    "test": "NODE_OPTIONS=\"--import ../../../config/vitest.jsx-runtime-loader.js\" vitest run --config ../../../config/vitest.config.js \"$PWD/test.jsx\"",
    "docs": "node ../../../scripts/workspace-packages/generate-readmes.js",
    "build": "NODE_ENV=production rollup -c ../../../config/rollup.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/HSLdevcom/digitransit-ui.git"
  },
  "keywords": [
    "digitransit-component",
    "Icon"
  ],
  "author": "Digitransit Authors",
  "license": "(AGPL-3.0 OR EUPL-1.2)",
  "devDependencies": {
    "@testing-library/react": "^12"
  },
  "peerDependencies": {
    "prop-types": "^15.8.1",
    "react": "^16.13.0"
  }
}
